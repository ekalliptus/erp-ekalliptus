{
  "name": "ekalliptus-erp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "functions/*",
    "apps/web"
  ],
  "scripts": {
    "tokens:sync": "node packages/tokens/scripts/sync-tokens.mjs",
    "db:push": "drizzle-kit push --force",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx packages/db/src/seed.ts",
    "build:db": "tsc -p packages/db/tsconfig.json --noEmit",
    "build:contracts": "tsc -p packages/contracts/tsconfig.json --noEmit",
    "build:api": "tsc -p functions/erpapi/tsconfig.json --noEmit",
    "build:web": "npm run build --workspace=apps/web",
    "build": "npm run tokens:sync && npm run build:db && npm run build:contracts && npm run build:api && npm run build:web",
    "deploy:neon": "neon deploy --env .env.local",
    "verify:e2e": "node scripts/verify-e2e.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@neon/config": "^1.14.5",
    "@neon/env": "^2.1.8"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
}
