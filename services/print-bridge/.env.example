# URL Backend MyEkalliptus ERP API
ERP_API_BASE_URL=https://br-odd-frog-aoghf6vq-erpapi.compute.c-2.ap-southeast-1.aws.neon.tech

# Token perangkat bridge (didapat sekali saat daftar perangkat di MyEkalliptus -> Smart Printer)
PRINT_AGENT_TOKEN=ekp_ganti_dengan_token_bridge_anda

# IP atau hostname mDNS HP Smart Tank 583 (kosongkan untuk auto-discover Wi-Fi)
PRINTER_HOST=192.168.0.5

# Mode uji tanpa mencetak fisik ke kertas (true = IPP Validate-Job saja, false = Print-Job fisik)
PRINT_DRY_RUN=false

# Aktifkan listener WhatsApp OpenWA (true/false)
ENABLE_OPENWA=true
OPENWA_SESSION_ID=ekalliptus-printer
OPENWA_SESSION_PATH=./.openwa-session

# Path Chrome lokal (opsional; otomatis mencari Google Chrome / Edge di Windows)
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
