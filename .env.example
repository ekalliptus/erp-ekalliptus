# Copy to .env.local or run `neon env pull`
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=ap-southeast-1

# Web frontend public config (Vite)
VITE_NEON_AUTH_URL=$NEON_AUTH_BASE_URL
VITE_NEON_REALTIME_URL=$NEON_REALTIME_URL
VITE_API_BASE_URL=https://<branch_id>-erpapi<function_host_suffix>

# ERP identity & storage defaults
OWNER_EMAIL=alul@ekalliptus.com
SMTP_FROM=alul@ekalliptus.com
STORAGE_BUCKET=assets

# Firebase Cloud Messaging (opsional: notifikasi push keluar)
# Isi otomatis dari .secrets/fcm-service-account.json saat neon deploy (lihat neon.ts)
FCM_SERVICE_ACCOUNT_JSON=
# Web Push certificate key dari Firebase Console (Cloud Messaging, publik)
VITE_FCM_VAPID_KEY=
