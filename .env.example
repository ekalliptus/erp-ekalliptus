# Isi sendiri; tidak ada kata sandi produksi bawaan.
POSTGRES_DB=nexus_core
POSTGRES_USER=nexus
POSTGRES_PASSWORD=
# Untuk penggunaan lokal, sesuaikan password (URL-encode karakter khusus).
DATABASE_URL=postgresql://nexus:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/nexus_core
COMPOSE_DATABASE_URL=postgresql://nexus:YOUR_URL_ENCODED_PASSWORD@postgres:5432/nexus_core
CORS_ORIGIN=http://localhost:3100
COMPOSE_CORS_ORIGIN=http://localhost:8080
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=
PORT=3000
HOST=127.0.0.1
BACKEND_URL=http://127.0.0.1:3000
# Compose melayani HTTP lokal. Untuk TLS produksi, ganti dengan domain valid.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
